		<query>ВЫБРАТЬ
	ГрафикОбязательныхПлатежейСрезПоследних.Период КАК ДатаНачалаГрафика,
	ГрафикОбязательныхПлатежейСрезПоследних.Сумма КАК Сумма,
	ГрафикОбязательныхПлатежейСрезПоследних.Периодичность.Уточнение КАК Уточнение,
	ГрафикОбязательныхПлатежейСрезПоследних.Периодичность.ТипПериодов КАК ТипПериодов,
	ГрафикОбязательныхПлатежейСрезПоследних.Периодичность.ЧислоПериодов КАК ЧислоПериодов
ПОМЕСТИТЬ вт_График
ИЗ
	РегистрСведений.ГрафикОбязательныхПлатежей.СрезПоследних(&amp;ТекущаяДата, ПредметПлатежа = &amp;ПредметПлатежа) КАК ГрафикОбязательныхПлатежейСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОплатаОбязательныхПлатежейОбороты.Период КАК ДатаПлатежа,
	ОплатаОбязательныхПлатежейОбороты.СуммаОборот КАК СуммаОплаты
ПОМЕСТИТЬ вт_Оплаты
ИЗ
	РегистрНакопления.ОплатаОбязательныхПлатежей.Обороты(, , Регистратор, ПредметПлатежа = &amp;ПредметПлатежа) КАК ОплатаОбязательныхПлатежейОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МАКСИМУМ(вт_Оплаты.ДатаПлатежа) КАК Дата
ПОМЕСТИТЬ вт_ПоследняяОплата
ИЗ
	вт_Оплаты КАК вт_Оплаты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВЫБОР
		КОГДА вт_График.Уточнение = ЗНАЧЕНИЕ(Перечисление.УточнениеПериодичности.Каждые)
			ТОГДА вт_Оплаты.ДатаПлатежа
		ИНАЧЕ ВЫБОР
				КОГДА вт_График.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.День)
					ТОГДА КОНЕЦПЕРИОДА(вт_Оплаты.ДатаПлатежа, ДЕНЬ)
				КОГДА вт_График.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Неделя)
					ТОГДА КОНЕЦПЕРИОДА(вт_Оплаты.ДатаПлатежа, НЕДЕЛЯ)
				КОГДА вт_График.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Месяц)
					ТОГДА КОНЕЦПЕРИОДА(вт_Оплаты.ДатаПлатежа, МЕСЯЦ)
				КОГДА вт_График.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Квартал)
					ТОГДА КОНЕЦПЕРИОДА(вт_Оплаты.ДатаПлатежа, КВАРТАЛ)
				ИНАЧЕ КОНЕЦПЕРИОДА(вт_Оплаты.ДатаПлатежа, ГОД)
			КОНЕЦ
	КОНЕЦ КАК ПлановаяДата,
	вт_График.Сумма КАК СуммаКВнесению,
	вт_Оплаты.ДатаПлатежа КАК ДатаПлатежа,
	вт_Оплаты.СуммаОплаты КАК СуммаОплаты
ИЗ
	вт_Оплаты КАК вт_Оплаты
		ЛЕВОЕ СОЕДИНЕНИЕ вт_График КАК вт_График
		ПО (ИСТИНА)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА втГрафик.Уточнение = ЗНАЧЕНИЕ(Перечисление.УточнениеПериодичности.Каждые)
			ТОГДА ВЫБОР
					КОГДА втГрафик.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.День)
						ТОГДА ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), ДЕНЬ, втГрафик.ЧислоПериодов)
					КОГДА втГрафик.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Неделя)
						ТОГДА ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), НЕДЕЛЯ, втГрафик.ЧислоПериодов)
					КОГДА втГрафик.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Месяц)
						ТОГДА ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), МЕСЯЦ, втГрафик.ЧислоПериодов)
					КОГДА втГрафик.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Квартал)
						ТОГДА ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), КВАРТАЛ, втГрафик.ЧислоПериодов)
					ИНАЧЕ ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), ГОД, втГрафик.ЧислоПериодов)
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА втГрафик.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.День)
					ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), ДЕНЬ, втГрафик.ЧислоПериодов), ДЕНЬ)
				КОГДА втГрафик.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Неделя)
					ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), НЕДЕЛЯ, втГрафик.ЧислоПериодов), НЕДЕЛЯ)
				КОГДА втГрафик.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Месяц)
					ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), МЕСЯЦ, втГрафик.ЧислоПериодов), МЕСЯЦ)
				КОГДА втГрафик.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Квартал)
					ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), КВАРТАЛ, втГрафик.ЧислоПериодов), КВАРТАЛ)
				ИНАЧЕ КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ЕСТЬNULL(втПоследняяОплата.Дата, втГрафик.ДатаНачалаГрафика), ГОД, втГрафик.ЧислоПериодов), ГОД)
			КОНЕЦ
	КОНЕЦ,
	втГрафик.Сумма,
	NULL,
	NULL
ИЗ
	вт_График КАК втГрафик
		ЛЕВОЕ СОЕДИНЕНИЕ вт_ПоследняяОплата КАК втПоследняяОплата
		ПО (ИСТИНА)

УПОРЯДОЧИТЬ ПО
	ПлановаяДата</query>
