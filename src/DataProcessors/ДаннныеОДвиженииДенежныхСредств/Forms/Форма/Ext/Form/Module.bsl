&НаСервере
Процедура РассчитатьОбщийОстатокВВалютеУчета()
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст =
	 "ВЫБРАТЬ
	 |	ОстаткиДенежныхСредствОстатки.Кошелек.Валюта КАК Валюта,
	 |	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК Сумма,
	 |	ВЫБОР
	 |		КОГДА КурсыВалютСрезПоследних.Курс ЕСТЬ NULL
	 |			ТОГДА 1
	 |		ИНАЧЕ КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность
	 |	КОНЕЦ КАК Коэффициент
	 |ПОМЕСТИТЬ вт_Предварительная
	 |ИЗ
	 |	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(&ДатаОкончания, ) КАК ОстаткиДенежныхСредствОстатки
	 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаОкончания, ) КАК КурсыВалютСрезПоследних
	 |		ПО ОстаткиДенежныхСредствОстатки.Кошелек.Валюта = КурсыВалютСрезПоследних.Валюта
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	вт_Предварительная.Валюта КАК Валюта,
	 |	вт_Предварительная.Сумма * вт_Предварительная.Коэффициент КАК Сумма
	 |ИЗ
	 |	вт_Предварительная КАК вт_Предварительная";
	 Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 
	 ОбщийОстаток = 0;
	 
	 Пока Выборка.Следующий() Цикл
		 
		ОбщийОстаток = ОбщийОстаток + Выборка.Сумма;
			 
	 КонецЦикла;	
	
 КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФинансовыеЦели()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФинансовыеЦели.Ссылка КАК Ссылка,
	|	ФинансовыеЦели.Наименование КАК Наименование,
	|	ФинансовыеЦели.ЦелеваяСумма КАК ЦелеваяСумма,
	|	ФинансовыеЦели.СрокДостижения КАК СрокДостижения,
	|	ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0) КАК ТекущийОстаток,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0) / ФинансовыеЦели.ЦелеваяСумма * 100 > 100
	|			ТОГДА 100
	|		ИНАЧЕ ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0) / ФинансовыеЦели.ЦелеваяСумма * 100
	|	КОНЕЦ КАК ПроцентВыполнения
	|ИЗ
	|	Справочник.ФинансовыеЦели КАК ФинансовыеЦели
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств.Остатки(&ДатаОкончания, Кошелек.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетов.Накопительный)) КАК ОстаткиДенежныхСредствОстатки
	|		ПО ФинансовыеЦели.СвязанныйСчет = ОстаткиДенежныхСредствОстатки.Кошелек
	|ГДЕ
	|	ФинансовыеЦели.Статус = &Статус";
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЦелей.Активна);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
 
    РезультатЗапроса = Запрос.Выполнить().Выгрузить(); 
	
	ФинансовыеЦели.Загрузить(РезультатЗапроса);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДолги()
	
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	Долги.Ссылка КАК Ссылка,
	 |	Долги.Наименование КАК Наименование,
	 |	Долги.СуммаДолга КАК СуммаДолга,
	 |	Долги.СрокВозврата КАК СрокВозврата,
	 |	Долги.Статус КАК СтатусДолга,
	 |	ВЫБОР
	 |		КОГДА (Долги.СуммаДолга - ЕСТЬNULL(ОстаткиПоДолгамОстатки.СуммаОстаток, 0)) / Долги.СуммаДолга * 100 > 100
	 |			ТОГДА 100
	 |		ИНАЧЕ (Долги.СуммаДолга - ЕСТЬNULL(ОстаткиПоДолгамОстатки.СуммаОстаток, 0)) / Долги.СуммаДолга * 100
	 |	КОНЕЦ КАК ПроцентВыполнения,
	 |	ОстаткиПоДолгамОстатки.СуммаОстаток КАК ТекущийОстаток,
	 |	Долги.НаправлениеДолга КАК НаправлениеДолга
	 |ИЗ
	 |	Справочник.Долги КАК Долги
	 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиПоДолгам.Остатки(&ДатаОкончания, ) КАК ОстаткиПоДолгамОстатки
	 |		ПО (ОстаткиПоДолгамОстатки.Долг = Долги.Ссылка)";
	 Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	 
	 РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	 
	 ОстаткиПоДолгам.Загрузить(РезультатЗапроса);
	 
КонецПроцедуры 

&НаСервере 
Процедура УстановитьОтбор()
	
	Если ОтборПоДолгам = "0" Тогда
		
		Элементы.ОстаткиПоДолгам.ОтборСтрок = Новый ФиксированнаяСтруктура();
		
	ИначеЕсли ОтборПоДолгам = "1" Тогда
		
		ЗначениеОтбора = Перечисления.НаправлениеДолга.НамДолжны;
		Элементы.ОстаткиПоДолгам.ОтборСтрок = Новый ФиксированнаяСтруктура("НаправлениеДолга", ЗначениеОтбора);
		
	ИначеЕсли ОтборПоДолгам = "2" Тогда
		
		ЗначениеОтбора = Перечисления.НаправлениеДолга.МыДолжны; 
		Элементы.ОстаткиПоДолгам.ОтборСтрок = Новый ФиксированнаяСтруктура("НаправлениеДолга", ЗначениеОтбора);
		
	КонецЕсли;

КонецПроцедуры


