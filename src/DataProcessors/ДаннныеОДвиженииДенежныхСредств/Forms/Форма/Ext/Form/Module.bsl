#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	 
	Период.ДатаНачала 		= НачалоМесяца(ТекущаяДата());
	Период.ДатаОкончания 	= КонецМесяца(ТекущаяДата());
	ОтборПоДолгам 			= "0";
	
	ОбновитьДанныеТЧ();
	ОбновитьДанныеДиаграмм();
	
КонецПроцедуры

#КонецОбласти  

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)   
	
	ОбновитьДанныеТЧ();
	ОбновитьДанныеДиаграмм();
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансовыеЦелиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ФинансовыеЦели.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено И ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) Тогда
		ПоказатьЗначение(, ТекущаяСтрока.Ссылка);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОстаткиПоДолгамВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ФинансовыеЦели.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено И ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) Тогда
		ПоказатьЗначение(, ТекущаяСтрока.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоДолгамПриИзменении(Элемент)
	
	УстановитьОтбор();
		
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДанные(Команда)
	
	ОбновитьДанныеТЧ();
	ОбновитьДанныеДиаграмм();   
	
КонецПроцедуры  

&НаКлиенте
Процедура ПровестиВыбранныеПлатежи(Команда)
	
	ПровестиВыбранныеПлатежиНаСервере();
	
	ОбновитьДанныеТЧ();
	ОбновитьДанныеДиаграмм();   
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте 
Процедура ОбновитьДанныеДиаграмм()  
	
	ЗаполнитьДанныеДиаграммыОДоходах();  
	ЗаполнитьДанныеДиаграммыОРасходах();
	
КонецПроцедуры 

&НаКлиенте 
Процедура ОбновитьДанныеТЧ()  
	
	ЗаполнитьОстаткиПоСчетам();  
	ЗаполнитьГрафикОбязательныхПлатежей();
	ЗаполнитьФинансовыеЦели();
	ЗаполнитьДолги();
	УстановитьУсловноеОформлениеГрафика();
	РассчитатьОбщийОстатокВВалютеУчета();
	                                      
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеДиаграммыОДоходах()  
	
    Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДвиженияДенежныхСредствОбороты.СтатьяДвиженияДенежныхСредств.Наименование КАК ИсточникИнформации,
	|	ДвиженияДенежныхСредствОбороты.СуммаОборот КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныхСредств.Обороты(&ДатаНачала, &ДатаОкончания, Период, СтатьяДвиженияДенежныхСредств.ТипСтатьи = &Доход) КАК ДвиженияДенежныхСредствОбороты";
	
	Запрос.УстановитьПараметр("ДатаНачала", 		Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 		Период.ДатаОкончания);  
	
	Запрос.УстановитьПараметр("Доход", 				Перечисления.ТипыСтатей.Доход);
	
	ДанныеОДоходе.Обновление = Ложь;
	ДанныеОДоходе.Очистить();

	Точка = ДанныеОДоходе.Точки.Добавить("Сумма");
	Точка.Текст = "Сумма";
	Точка.ПриоритетЦвета = Ложь;

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл

	    Серия = ДанныеОДоходе.Серии.Добавить(Выборка.ИсточникИнформации);
	    ДанныеОДоходе.УстановитьЗначение(Точка, Серия, Выборка.Сумма, Строка(Выборка.Сумма));

	КонецЦикла;

	ДанныеОДоходе.Обновление = Истина;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьДанныеДиаграммыОРасходах()  
	
    Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДвиженияДенежныхСредствОбороты.СтатьяДвиженияДенежныхСредств.Наименование КАК ИсточникИнформации,
	|	ДвиженияДенежныхСредствОбороты.СуммаОборот КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныхСредств.Обороты(&ДатаНачала, &ДатаОкончания, Период, СтатьяДвиженияДенежныхСредств.ТипСтатьи = &Расход) КАК ДвиженияДенежныхСредствОбороты";
	
	Запрос.УстановитьПараметр("ДатаНачала", 		Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 		Период.ДатаОкончания);  
	
	Запрос.УстановитьПараметр("Расход", 			Перечисления.ТипыСтатей.Расход);
	
	ДанныеОРасходе.Обновление = Ложь;
	ДанныеОРасходе.Очистить();

	Точка = ДанныеОРасходе.Точки.Добавить("Сумма");
	Точка.Текст = "Сумма";
	Точка.ПриоритетЦвета = Ложь;

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл

	    Серия = ДанныеОРасходе.Серии.Добавить(Выборка.ИсточникИнформации);
	    ДанныеОРасходе.УстановитьЗначение(Точка, Серия, Выборка.Сумма, Строка(Выборка.Сумма));

	КонецЦикла;

	ДанныеОРасходе.Обновление = Истина;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьОстаткиПоСчетам()  
	
    Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиДенежныхСредствОстатки.Кошелек КАК Счет,
	|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК Сумма,
	|	ОстаткиДенежныхСредствОстатки.Кошелек.Валюта КАК Валюта
	|ИЗ
	|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(&ДатаОкончания, ) КАК ОстаткиДенежныхСредствОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ";
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания); 
	
	ОстаткиПоСчетам.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьГрафикОбязательныхПлатежей()  
	
    Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикОбязательныхПлатежейСрезПоследних.Регистратор КАК ГрафикПлатежей,
	|	ГрафикОбязательныхПлатежейСрезПоследних.Регистратор.Счет КАК Кошелек,
	|	ГрафикОбязательныхПлатежейСрезПоследних.Регистратор.СтатьяРасхода КАК СтатьяРасхода,
	|	ГрафикОбязательныхПлатежейСрезПоследних.Регистратор.Контрагент КАК Контрагент,
	|	ГрафикОбязательныхПлатежейСрезПоследних.ПредметПлатежа КАК ПредметПлатежа,
	|	ГрафикОбязательныхПлатежейСрезПоследних.Периодичность КАК Периодичность,
	|	ГрафикОбязательныхПлатежейСрезПоследних.Сумма КАК Сумма,
	|	ГрафикОбязательныхПлатежейСрезПоследних.ДоДостиженияСуммы КАК ДоДостиженияСуммы,
	|	ГрафикОбязательныхПлатежейСрезПоследних.ОбщаяСуммаКОплате КАК ОбщаяСуммаКОплате,
	|	ГрафикОбязательныхПлатежейСрезПоследних.Период КАК ДатаНазначенияПлатежа
	|ПОМЕСТИТЬ втДанныеКОплате
	|ИЗ
	|	РегистрСведений.ГрафикОбязательныхПлатежей.СрезПоследних(&ДатаОкончания, ) КАК ГрафикОбязательныхПлатежейСрезПоследних
	|ГДЕ
	|	(ГрафикОбязательныхПлатежейСрезПоследних.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ ГрафикОбязательныхПлатежейСрезПоследних.ДатаОкончания >= &ДатаНачала)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанныеКОплате.ПредметПлатежа КАК ПредметПлатежа,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ОплатаОбязательныхПлатежей.Период ЕСТЬ NULL
	|				ТОГДА втДанныеКОплате.ДатаНазначенияПлатежа
	|			ИНАЧЕ ОплатаОбязательныхПлатежей.Период
	|		КОНЕЦ) КАК ДатаПоследнегоПлатежа,
	|	СУММА(ОплатаОбязательныхПлатежей.Сумма) КАК ОбщаяСуммаПлатежа
	|ПОМЕСТИТЬ втДанныеОПредыдущихОплатах
	|ИЗ
	|	втДанныеКОплате КАК втДанныеКОплате
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОплатаОбязательныхПлатежей КАК ОплатаОбязательныхПлатежей
	|		ПО втДанныеКОплате.ПредметПлатежа = ОплатаОбязательныхПлатежей.ПредметПлатежа
	|
	|СГРУППИРОВАТЬ ПО
	|	втДанныеКОплате.ПредметПлатежа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанныеКОплате.Контрагент КАК Контрагент,
	|	втДанныеКОплате.Кошелек КАК Кошелек,
	|	втДанныеКОплате.СтатьяРасхода КАК СтатьяРасхода,
	|	втДанныеКОплате.ГрафикПлатежей КАК ГрафикПлатежей,
	|	втДанныеКОплате.ПредметПлатежа КАК ПредметПлатежа,
	|	ВЫБОР
	|		КОГДА втДанныеКОплате.Периодичность.Уточнение = ЗНАЧЕНИЕ(Перечисление.УточнениеПериодичности.Каждые)
	|			ТОГДА ВЫБОР
	|					КОГДА втДанныеКОплате.Периодичность.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.День)
	|						ТОГДА ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, ДЕНЬ, втДанныеКОплате.Периодичность.ЧислоПериодов)
	|					КОГДА втДанныеКОплате.Периодичность.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.НЕДЕЛЯ)
	|						ТОГДА ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, НЕДЕЛЯ, втДанныеКОплате.Периодичность.ЧислоПериодов)
	|					КОГДА втДанныеКОплате.Периодичность.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.МЕСЯЦ)
	|						ТОГДА ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, МЕСЯЦ, втДанныеКОплате.Периодичность.ЧислоПериодов)
	|					КОГДА втДанныеКОплате.Периодичность.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Квартал)
	|						ТОГДА ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, КВАРТАЛ, втДанныеКОплате.Периодичность.ЧислоПериодов)
	|					ИНАЧЕ ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, ГОД, втДанныеКОплате.Периодичность.ЧислоПериодов)
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА втДанныеКОплате.Периодичность.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.День)
	|					ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, ДЕНЬ, втДанныеКОплате.Периодичность.ЧислоПериодов), ДЕНЬ)
	|				КОГДА втДанныеКОплате.Периодичность.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.НЕДЕЛЯ)
	|					ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, НЕДЕЛЯ, втДанныеКОплате.Периодичность.ЧислоПериодов), НЕДЕЛЯ)
	|				КОГДА втДанныеКОплате.Периодичность.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.МЕСЯЦ)
	|					ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, МЕСЯЦ, втДанныеКОплате.Периодичность.ЧислоПериодов), МЕСЯЦ)
	|				КОГДА втДанныеКОплате.Периодичность.ТипПериодов = ЗНАЧЕНИЕ(Перечисление.ТипыПериодов.Квартал)
	|					ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, КВАРТАЛ, втДанныеКОплате.Периодичность.ЧислоПериодов), КВАРТАЛ)
	|				ИНАЧЕ КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(втДанныеОПредыдущихОплатах.ДатаПоследнегоПлатежа, ГОД, втДанныеКОплате.Периодичность.ЧислоПериодов), ГОД)
	|			КОНЕЦ
	|	КОНЕЦ КАК ПлановаяДата,
	|	ВЫБОР
	|		КОГДА втДанныеКОплате.ДоДостиженияСуммы
	|			ТОГДА втДанныеКОплате.Сумма
	|		ИНАЧЕ втДанныеКОплате.Сумма
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ втПредварительная
	|ИЗ
	|	втДанныеКОплате КАК втДанныеКОплате
	|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеОПредыдущихОплатах КАК втДанныеОПредыдущихОплатах
	|		ПО втДанныеКОплате.ПредметПлатежа = втДанныеОПредыдущихОплатах.ПредметПлатежа
	|ГДЕ
	|	ВЫБОР
	|			КОГДА втДанныеКОплате.ДоДостиженияСуммы
	|				ТОГДА втДанныеКОплате.ОбщаяСуммаКОплате > втДанныеОПредыдущихОплатах.ОбщаяСуммаПлатежа
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПредварительная.Контрагент КАК Контрагент,
	|	втПредварительная.Кошелек КАК Кошелек,
	|	втПредварительная.СтатьяРасхода КАК СтатьяРасхода,
	|	втПредварительная.ГрафикПлатежей КАК ГрафикПлатежей,
	|	втПредварительная.ПредметПлатежа КАК ПредметПлатежа,
	|	втПредварительная.ПлановаяДата КАК ПлановаяДата,
	|	втПредварительная.Сумма КАК Сумма
	|ИЗ
	|	втПредварительная КАК втПредварительная
	|ГДЕ
	|	втПредварительная.ПлановаяДата <= &ДатаОкончания";
	Запрос.УстановитьПараметр("ДатаНачала", 		Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 		Период.ДатаОкончания); 
	
	ГрафикОбязательныхПлатежей.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры    

&НаСервере
Процедура ПровестиВыбранныеПлатежиНаСервере()  
	
	СтруктураОтбора = Новый Структура("Выбрать", Истина);
	
	СтрокиДляПроведения = ГрафикОбязательныхПлатежей.НайтиСтроки(СтруктураОтбора);
	
	Для Каждого СтрокаДляПроведения Из СтрокиДляПроведения Цикл 
		
		ДокументОбъект = Документы.Расход.СоздатьДокумент();
		
		ДокументОбъект.Дата = ТекущаяДата();    
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДляПроведения); 
		
		ДокументОбъект.Комментарий = СтрШаблон("Создан автоматически из обработки %1", ТекущаяДата());    
		
		Попытка
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере 
Процедура УстановитьУсловноеОформлениеГрафика()

	ГраницаСегодня = НачалоДня(ТекущаяДата());
	ГраницаЧерезНеделю = КонецДня(ТекущаяДата() + 86400*7);
	
	Оформление = ЭтаФорма.УсловноеОформление;
	Оформление.Элементы.Очистить();
	
